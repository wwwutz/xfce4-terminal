+        {
+                auto const rgb_mask = VTE_RGB_COLOR_MASK(8, 8, 8);
+                auto const dim = !(fore & rgb_mask) && (fore & VTE_DIM_COLOR);
+                auto const plain_fore = dim ? (fore & ~VTE_DIM_COLOR) : fore;
+                if (plain_fore != back)
+                        ensure_minimum_contrast(fg, bg, minimum_contrast(), dim);
+        }
+
